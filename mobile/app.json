{
  "expo": {
    "name": "My PA",
    "slug": "my-pa",
    "version": "0.1.0",
    "scheme": "mypa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adeltaha.mypa.expo"
    },
    "android": {
      "package": "com.adeltaha.mypa.expo"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "My PA",
      "shortName": "My PA",
      "themeColor": "#14201C",
      "backgroundColor": "#14201C"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "اسمح لـ My PA بتسجيل رسالتك الصوتية وتحويلها إلى نص.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "اسمح لـ My PA بفتح التطبيق ببصمة الوجه، بنفس طريقة فتح هاتفك."
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
