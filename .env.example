API_HOST=127.0.0.1
API_PORT=3001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
API_DB=data/my-pa.sqlite
API_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,https://adeltaha123.github.io
# Native builds: set this to your deployed HTTPS API origin before building.
# This is a public URL, never an API secret.
# VITE_API_URL=https://api.your-domain.example

# Social sign-in (Google, Apple, Meta). See docs/SOCIAL-LOGIN.md.
# Providers only redirect to HTTPS, so this must be a public HTTPS address that reaches this API.
OAUTH_PUBLIC_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: the Services ID, your Team ID, the Sign in with Apple key ID, and the .p8 key with newlines written as \n.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
META_APP_ID=
META_APP_SECRET=

# Subscriptions are activated by hand with `npm run plan` until payments are connected.
# Shown on the Account screen as who to contact to subscribe, e.g. "WhatsApp 01xxxxxxxxx".
SUBSCRIBE_CONTACT=

# Cloudflare deploys (npm run deploy:api) and live plan changes (npm run plan). Never commit real values.
CLOUDFLARE_API_TOKEN=
ADMIN_TOKEN=
