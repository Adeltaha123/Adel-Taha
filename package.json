{
  "name": "my-pa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "expo:dev": "node scripts/expo-dev.mjs",
    "server:online": "node scripts/server-online.mjs",
    "plan": "node --import tsx scripts/plan.ts",
    "expo:start": "npm --prefix mobile start",
    "expo:check": "npm --prefix mobile run typecheck",
    "web:build": "cd mobile && npx expo export --platform web --output-dir dist",
    "test:expo": "node scripts/test-expo.mjs",
    "api:dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "api:build": "tsc -p server/tsconfig.json",
    "api:start": "node --env-file-if-exists=.env build-api/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run api:build"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "cloudflared": "^0.7.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
