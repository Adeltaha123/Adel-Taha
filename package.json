{
  "name": "my-pa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "expo:start": "npm --prefix mobile start",
    "expo:dev": "node scripts/expo-dev.mjs",
    "expo:check": "npm --prefix mobile run typecheck",
    "test:expo": "node scripts/test-expo.mjs",
    "api:dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "api:build": "tsc -p server/tsconfig.json",
    "api:start": "node --env-file-if-exists=.env build-api/server/index.js",
    "typecheck": "tsc --noEmit && node scripts/check-modules.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build && npm run api:build",
    "mobile:sync": "npm run build && cap sync",
    "android:add": "npm run build && cap add android",
    "android:open": "cap open android",
    "ios:add": "npm run build && cap add ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
