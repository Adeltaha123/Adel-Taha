{
  "name": "My PA",
  "short_name": "My PA",
  "description": "Private personal assistant: voice notes and chats in Arabic, English or Franco become prioritized tasks.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0C1311",
  "theme_color": "#14201C",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [ { "name": "file", "accept": ["text/plain", ".txt"] } ]
    }
  }
}
